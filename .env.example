# Variables de l'environnement Docker de développement
# Copier en .env :  cp .env.example .env   (le .env n'est jamais versionné)
# Valeurs de développement uniquement : rien de tout ça ne sert en recette ou en production.

# Ports exposés sur la machine (127.0.0.1 uniquement)
API_PORT=8000
FRONT_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL : compte propriétaire du schéma (migrations).
# Les comptes à droits limités sk_app / sk_admin / sk_readonly arrivent avec T-01 (api/sql/roles/).
POSTGRES_DB=sidekey
POSTGRES_USER=sidekey_owner
POSTGRES_PASSWORD=change_me_dev

# Redis
REDIS_PASSWORD=change_me_dev

# Xdebug : off | debug | coverage
XDEBUG_MODE=off
