@startuml seq-paiement
' ============================================================================
' SideKey — Séquence : paiement simulé et validation de la commande
' Objet    : paiement d'une commande par carte fictive, idempotence, refus,
'            anti-fraude « Équilibré » et validation atomique des clés.
' Source   : docs/cahier_des_charges_v1.2_SideKey.md §5.4, §6.2, §6.3,
'            §6.4, §10.3, §11.6 ; ADR-0008 ; implémentation F-07
'            (api/src/Service/Paiement/PaiementService.php)
' Exports  : docs/uml/exports/seq-paiement.svg et .png (make uml)
' ============================================================================

title Séquence — paiement simulé et validation de la commande\n<size:12>Hors transaction pendant l'appel au prestataire · idempotence · anti-fraude « Équilibré »</size>

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam ArrowColor #455A64
skinparam ArrowFontColor #37474F
skinparam BackgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #455A64
  ActorBorderColor #37474F
  ActorBackgroundColor #F7F9FB
  LifeLineBorderColor #90A4AE
  ParticipantBorderColor #37474F
  ParticipantBackgroundColor #F7F9FB
  DividerBackgroundColor #ECEFF1
}

autonumber "<b>00"
participant "Client" as C
participant "API\nPaiementController" as API
participant "PaiementService" as PAY
participant "FournisseurPaiementSimule\n(Strategy)" as PSP
database "PostgreSQL 17" as PG
participant "Redis" as R

C -> API : POST /api/commandes/{reference}/paiement\nen-tête Idempotency-Key · { numeroCarte, expiration, cryptogramme }
activate API
API -> API : jeton JWT, permission « commander »,\nDTO JSON validé (format) ; aucun montant lu
API -> PAY : payer(compte, reference, carte, cle)
activate PAY
PAY -> PAY : clé stockée = SHA-256(client + clé) ;\ncarte : Luhn, expiration — <b>422</b> par champ si invalide\n(rien n'est compté)

PAY -> PG : SELECT paiement WHERE cle_idempotence = empreinte\n(filtré sur le client)
alt clé déjà enregistrée (rejeu)
  PG --> PAY : tentative existante
  PAY --> API : même réponse (aucun second débit, prestataire non rappelé)
  API --> C : <b>200</b> + Idempotent-Replayed (accepté) · <b>402</b> (refusé) ·\n<b>409</b> (en cours, ou clé d'une autre commande)
else première tentative
  PAY -> R : INCR rl:pay:{userId} (10 / h)\nGET fraud:block:{userId}\nZCOUNT fraud:keys24h:{userId} (fenêtre glissante 24 h)
  note right of R : Redis injoignable → <b>503</b> :\non refuse, on ne laisse jamais passer sans contrôle\n(Fail Securely, ADR-0008).
  PAY -> PG : SELECT commande, montant, nb de clés,\nancienneté du compte, première commande ?
  alt client bloqué 1 h
    PAY --> API : PaiementBloqueException
    API --> C : <b>429</b> + Retry-After
  else plafond de 10 clés / 24 h dépassé
    PAY --> API : LimiteClesException
    API --> C : <b>422</b> — avant tout débit, commande annulable
  else commande introuvable, d'autrui, déjà payée,\nexpirée ou expirant dans moins de 30 s
    PAY --> API : CommandeIntrouvable / NonPayable
    API --> C : <b>404</b> (identique pour autrui) · <b>409</b>
  else commande payable
    PAY -> R : SET idem:{empreinte} NX EX 24 h
    PAY -> PG : BEGIN ; SELECT commande FOR UPDATE ;\nINSERT paiement (montant de la base, EN_ATTENTE) ; COMMIT
    note right of PG : Index unique partiel <b>uq_paiement_commande_actif</b> :\nun seul paiement EN_ATTENTE ou ACCEPTE par commande —\ndeux clés différentes, un seul débit possible.
    PAY -> PSP : autoriser(montant en centimes, carte)
    activate PSP
    note right of PSP : Appel <b>hors transaction</b> (CDC §10.3) :\naucun verrou PostgreSQL n'est tenu\npendant l'appel au prestataire.
    alt 4242 4242 4242 4242 — accepté
      PSP --> PAY : ACCEPTE (ok)
      deactivate PSP
      alt compte < 24 h et montant > 150 €,\nou première commande > 200 €
        PAY -> PG : BEGIN ; UPDATE paiement ACCEPTE ;\nUPDATE commande SET statut = 'A_VERIFIER' ; COMMIT
        note right of PG : Les clés restent RESERVEE :\nnon vendues, non révélables,\nnon libérées par l'expiration.
      else commande ordinaire
        PAY -> PG : BEGIN ; UPDATE paiement ACCEPTE ;\nSELECT fn_valider_commande(commande) ; COMMIT
        PG -> PG : clés RESERVEE → VENDUE,\ncommande → PAYEE, payee_le = now()
      end
      PAY -> R : ZADD fraud:keys24h (clés payées) ; DEL fraud:fails ;\nDEL resa:{commandeId}
      PAY -> PG : journal d'audit (PAIEMENT_ACCEPTE,\npuis COMMANDE_A_VERIFIER si besoin)
      PAY --> API : commande PAYEE ou A_VERIFIER
      API --> C : <b>200</b> — confirmation (clés dans « Mes commandes »)\nou « en cours de vérification », sans détail technique
    else 4000…0002 refusé · …9995 fonds insuffisants · …0119 délai dépassé
      PSP --> PAY : REFUSE ou ERREUR (code de retour)
      deactivate PSP
      PAY -> PG : UPDATE paiement SET statut = 'REFUSE' | 'ERREUR'
      PAY -> R : script Lua : INCR fraud:fails (TTL 1 h) ;\n3e échec → SET fraud:block EX 1 h
      PAY --> API : PaiementRefuseException (code, tentatives restantes)
      API --> C : <b>402</b> — réservation conservée jusqu'à la fin\ndu TTL de 15 min ; nouvel essai avec une nouvelle clé (US-36)
    end
  end
end
deactivate PAY
deactivate API

note over C, R : Aucune donnée de carte n'est stockée ni journalisée :\nseuls le code de retour et les 4 derniers chiffres sont conservés.\nLa clé de licence n'est déchiffrée qu'à la révélation par son propriétaire (voir seq-revelation-cle).\nL'e-mail de confirmation (Messenger) n'est pas encore branché.

@enduml
