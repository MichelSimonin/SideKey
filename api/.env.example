# Copier ce fichier en .env :  cp .env.example .env
# Ne jamais mettre de vrai secret ici : ce fichier est versionné.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=a_generer_en_local
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

###> base de données (PostgreSQL) ###
# Sous Docker, DATABASE_URL et REDIS_URL sont fournies par compose.yaml (à partir du .env racine)
# et l'emportent sur ces valeurs. Celles-ci ne servent qu'en dehors de Docker.
DATABASE_URL="postgresql://sk_app:change_me_dev@127.0.0.1:5432/sidekey?serverVersion=17&charset=utf8"
###< base de données ###

###> redis ###
REDIS_URL=redis://:change_me_dev@127.0.0.1:6379
###< redis ###

###> sécurité ###
# Clés JWT générées en local, jamais versionnées (config/jwt/*.pem)
JWT_PASSPHRASE=change_me
# Clés de chiffrement des clés de licence (AES-GCM) et d'empreinte (HMAC), en base64
LICENSE_KEY_ENC_KEY=
LICENSE_KEY_HMAC_KEY=
# En dev le front passe par le proxy Vite (même origine) : CORS inutile
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< sécurité ###
